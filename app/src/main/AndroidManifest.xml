<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ACCESS_NETWORK_STATE is deliberately NOT declared here. From 1.0.0-beta.6 the SDK declares it
         in its own manifest and the merger brings it in; this app dropping the line is what proves that
         works from a consumer's side. Check it with:
           grep ACCESS_NETWORK_STATE app/build/intermediates/packaged_manifests/*/*/AndroidManifest.xml
         Without the permission — from either side — NetworkChangeCollector never installs its callback,
         every event reports not_connected, and no network_change event is emitted at all. -->

    <!-- INTERNET stays ours: the app needs it for its own API, and the SDK deliberately does not
         declare it so the requirement is not hidden from the consumer. -->

    <application
        android:name=".app.RortyApp"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pantrixrortyanddemo">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Pantrixrortyanddemo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>